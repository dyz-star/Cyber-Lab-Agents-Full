# =============================================
# Cyber-Lab-Agents 配置模板
# 请复制此文件为 .env 并填写实际值
# =============================================

# ====================
# 通用配置
# ====================
APP_NAME=Cyber-Lab-Agents
ENV=development
DEBUG=true
LOG_LEVEL=INFO

# ====================
# 数据库
# ====================
DATABASE_URL=sqlite+aiosqlite:///./data/cyber_lab.db

# ====================
# Agent 模型配置（每个Agent独立配置）
# ====================

# 导师 - 使用最强模型
MENTOR_MODEL=gpt-4o
MENTOR_API_KEY=sk-xxx
MENTOR_TEMPERATURE=0.7

# 小导1 - 科研任务
JUNIOR_PI_1_MODEL=gpt-4o
JUNIOR_PI_1_API_KEY=sk-xxx

# 小导2 - 日常任务
JUNIOR_PI_2_MODEL=gpt-4o
JUNIOR_PI_2_API_KEY=sk-xxx

# 小导3 - 备用
JUNIOR_PI_3_MODEL=gpt-4o
JUNIOR_PI_3_API_KEY=sk-xxx

# 博士1 - 文献检索
PH_D_1_MODEL=gpt-4o-mini
PH_D_1_API_KEY=sk-xxx
PH_D_1_SKILLS=arxiv,semantic_scholar

# 博士2 - 代码执行
PH_D_2_MODEL=gpt-4o-mini
PH_D_2_API_KEY=sk-xxx
PH_D_2_SKILLS=python_exec,bash

# 博士3 - 文档排版
PH_D_3_MODEL=gpt-4o-mini
PH_D_3_API_KEY=sk-xxx
PH_D_3_SKILLS=markdown,latex

# 马屁精 - 轻量模型（陪聊）
SYCOPHANT_MODEL=claude-3-haiku
SYCOPHANT_API_KEY=sk-ant-xxx

# ====================
# 飞书 Webhook 配置
# ====================
FEISHU_APP_ID=cli_xxxxxxxx
FEISHU_APP_SECRET=xxxxxxxx
FEISHU_VERIFY_TOKEN=your_verify_token
FEISHU_ENCRYPT_KEY=your_encrypt_key
FEISHU_WEBHOOK_URL=https://open.feishu.cn/open-apis/bot/v2/hook/xxxxxxxx

# ====================
# 工作流配置
# ====================
MAX_RETRIES=3
RETRY_DELAY_SECONDS=60
TASK_TIMEOUT_SECONDS=3600

# ====================
# 记忆库配置
# ====================
MEMORY_PATH=./memory_bank
RAG_TOP_K=3
EMBEDDING_MODEL=text-embedding-ada-002

# ====================
# 前端看板配置
# ====================
DASHBOARD_HOST=0.0.0.0
DASHBOARD_PORT=8000
CORS_ORIGINS=*

# ====================
# Docker 配置
# ====================
DOCKER_IMAGE=cyber-lab-agents:latest
DOCKER_CONTAINER_NAME=cyber-lab-agents
DOCKER_PORT_MAP=8000:8000